%% ER-модель прокату туристичного спорядження.
erDiagram
    Customer ||..o{ Rental : "бронює"
    PickupPoint ||..o{ Rental : "видає"
    EquipmentType ||..o{ EquipmentItem : "описує"
    Rental ||..|{ RentalLine : "містить"
    EquipmentItem ||..o{ RentalLine : "орендується"
    EquipmentType }o..|{ Tag : "має теги"

    Customer {
        UUID id PK
        string full_name
        string email UK
        string phone
    }
    PickupPoint {
        UUID id PK
        string name
        string address
    }
    EquipmentType {
        UUID id PK
        string name
        string description
        decimal daily_rate
    }
    EquipmentItem {
        UUID id PK
        UUID equipment_type_id FK
        string inventory_code UK
        string status
    }
    Tag {
        UUID id PK
        string name UK
    }
    Rental {
        UUID id PK
        UUID customer_id FK
        UUID pickup_point_id FK
        timestamp starts_at
        timestamp due_at
        string status
    }
    RentalLine {
        UUID id PK
        UUID rental_id FK "пара з equipment_item_id не повторюється"
        UUID equipment_item_id FK
        decimal daily_rate_at_booking
        timestamp returned_at "nullable"
    }
